
// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  user         String
  email        String    @unique
  passwordHash String
  phone        String?
  sessions     Session[]
  projects     Project[]
}

enum ProjectRole {
  owner
}

enum MemberRole {
  admin
  member
}

enum InvestmentStatus {
  pending
  approved
  rejected
}

enum CashType {
  deposit
  withdrawal
}

enum CashStatus {
  pending
  completed
}

model ProjectCashTransaction {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String     @db.ObjectId
  userId      String     @db.ObjectId
  type        CashType
  status      CashStatus
  amount      Int
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  processedBy String?   @db.ObjectId

  @@index([projectId, userId, createdAt])
  @@index([projectId, status])
}

model ProjectCashBalance {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  projectId String @db.ObjectId
  userId    String @db.ObjectId
  amount    BigInt

  @@unique([projectId, userId])
}

model Project {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  ownerRole   ProjectRole @default(owner)
  ownerId     String      @db.ObjectId
  owner       User        @relation(fields: [ownerId], references: [id])
  createdAt   DateTime    @default(now())
  startsAt    DateTime?
  endsAt      DateTime?
  budget      Int?

  @@index([ownerId, createdAt])
}

model ProjectMember {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  projectId String     @db.ObjectId
  userId    String     @db.ObjectId
  role      MemberRole @default(member)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @unique @db.ObjectId
  tokenHash String   @unique
  expiresAt DateTime
}

type ProjectPrice {
  amount Int
  at     DateTime
  units  Float?
}

model ProjectAsset {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  projectId String         @db.ObjectId
  name      String
  prices    ProjectPrice[]

  @@index([projectId])
}

model Investment {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  projectId  String           @db.ObjectId
  userId     String           @db.ObjectId
  assetId    String           @db.ObjectId
  cost       Int
  unitPrice  Int
  status     InvestmentStatus @default(pending)
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?
  reviewerId String?          @db.ObjectId

  @@index([projectId, status])
  @@index([projectId, userId])
}

model ProjectBankAccount {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  projectId String @db.ObjectId
  userId    String @db.ObjectId
  bank      String
  encrypted String
  lastFour  String

  @@unique([projectId, userId])
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique
  expiresAt DateTime
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
