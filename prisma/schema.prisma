// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  user         String
  email        String    @unique
  passwordHash String
  phone        String?
  sessions     Session[]
  projects     Project[]
}

enum ProjectRole {
  owner
}

enum MemberRole {
  admin
  member
}

enum InvestmentStatus {
  pending
  approved
  rejected
}

enum CashType {
  deposit
  withdrawal
}

enum CashStatus {
  pending
  completed
}

model ProjectCashTransaction {
  id          String     @id @default(uuid())
  projectId   String
  userId      String
  type        CashType
  status      CashStatus
  amount      Int
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  processedBy String?

  @@index([projectId, userId, createdAt])
  @@index([projectId, status])
}

model ProjectCashBalance {
  id        String @id @default(uuid())
  projectId String
  userId    String
  amount    BigInt

  @@unique([projectId, userId])
}

model Project {
  id          String      @id @default(uuid())
  name        String
  description String
  ownerRole   ProjectRole @default(owner)
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id])
  createdAt   DateTime    @default(now())
  startsAt    DateTime?
  endsAt      DateTime?
  budget      Int?

  @@index([ownerId, createdAt])
}

model ProjectMember {
  id        String     @id @default(uuid())
  projectId String
  userId    String
  role      MemberRole @default(member)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvite {
  id        String   @id @default(uuid())
  projectId String   @unique
  tokenHash String   @unique
  expiresAt DateTime
}

model ProjectPrice {
  id      Int          @id @default(autoincrement())
  assetId String
  asset   ProjectAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  amount  Int
  at      DateTime
  units   Float?

  @@index([assetId, at])
}

model ProjectAsset {
  id        String         @id @default(uuid())
  projectId String
  name      String
  prices    ProjectPrice[]

  @@index([projectId])
}

model Investment {
  id         String           @id @default(uuid())
  projectId  String
  userId     String
  assetId    String
  cost       Int
  unitPrice  Int
  status     InvestmentStatus @default(pending)
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?
  reviewerId String?

  @@index([projectId, status])
  @@index([projectId, userId])
}

model ProjectBankAccount {
  id        String @id @default(uuid())
  projectId String
  userId    String
  bank      String
  encrypted String
  lastFour  String

  @@unique([projectId, userId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
